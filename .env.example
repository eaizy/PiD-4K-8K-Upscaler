# ════════════════════════════════════════════════════════════════════
#  PiD Studio — configuration
#  Copy this file to `.env` and fill in HF_TOKEN. Everything else has a
#  sensible default; the app will auto-install ComfyUI and download the
#  model weights into the right places on first run.
# ════════════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────────────
# Hugging Face access token (read scope). Needed to download the NVIDIA
# PiD weights from https://huggingface.co/nvidia/PiD (a gated repo — you
# must accept its NSCLv1 non-commercial license on the model page first).
# Create one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ── OPTIONAL: ports ───────────────────────────────────────────────────
PID_PORT=17820          # FastAPI backend (this app)
COMFY_HOST=127.0.0.1
COMFY_PORT=8188         # ComfyUI backend

# ── OPTIONAL: install locations (auto-created) ────────────────────────
# Where everything lives. Defaults keep it self-contained inside the repo
# so a fork "just works"; override to share an existing ComfyUI/models.
PID_HOME=               # default: <repo>/.pidstudio
COMFY_ROOT=             # default: <PID_HOME>/ComfyUI  (auto-installed if missing)
PID_MODELS_ROOT=        # default: <PID_HOME>/models   (subprocess scale_rae checkpoints)
PID_DATA_ROOT=          # default: <repo>/data         (user projects + outputs)

# ── OPTIONAL: behavior ────────────────────────────────────────────────
# If true, the backend will offer to auto-install ComfyUI + download models
# when the app starts and finds them missing. Set false for manual control.
PID_AUTO_INSTALL=true
